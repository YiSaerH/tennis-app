/* 全局样式：与网页版同一套设计（米白底 / 网球绿 / 球类黄绿） */
page {
  background: #f7f7f4;
  color: #1f2421;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.wrap { padding: 0 24rpx 60rpx; }

/* 全站可点元素一律用 view + 下面的类：view 没有原生 button 的最小宽度问题
   （实测 button 的 min-width 连 min-width: 0 都压不住，FAB 被撑成横向椭圆、
   添加按钮被撑成半行宽都是它）。这段 button 重置仅作兜底。 */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  min-width: 0;
  min-height: 0;
}
button::after { border: none; }

/* view 按钮的按压反馈（配合 hover-class="btn-hover"） */
.btn-hover { opacity: 0.72; }

.primary {
  background: #2e7d32;
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.mini {
  border: 1rpx solid #e6e4dc;
  background: #fff;
  color: #6b7269;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}
.mini.danger { color: #b00020; border-color: #f3d4d9; }

/* 卡片 */
.card {
  background: #fff;
  border: 1rpx solid #e6e4dc;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06), 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; }
.card-title { font-size: 34rpx; font-weight: 700; }
.card-meta { color: #6b7269; font-size: 26rpx; margin-top: 4rpx; }
.card-stats { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.card-actions { display: flex; gap: 12rpx; margin-top: 28rpx; border-top: 1rpx dashed #e6e4dc; padding-top: 24rpx; }
.card-actions .mini { flex: 1; }

.pill {
  background: #e8f3e8;
  color: #1b5e20;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  white-space: nowrap;
}
.pill.neutral { background: #f0efe9; color: #5d5648; }
.pill.big { background: #c6ff3d; color: #1f2421; }

/* 页头 */
.page-head { display: flex; align-items: baseline; justify-content: space-between; margin: 40rpx 0 28rpx; gap: 24rpx; flex-wrap: wrap; }
.h2 { font-size: 44rpx; font-weight: 700; }
.sub { color: #6b7269; font-size: 28rpx; }

/* 搜索框：原生 input 不吃纵向 padding，必须用 height+line-height 撑起并居中文字 */
.search {
  width: 100%;
  border: 1rpx solid #e6e4dc;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  background: #fff;
  box-sizing: border-box;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 96rpx 40rpx;
  color: #6b7269;
  border: 4rpx dashed #e6e4dc;
  border-radius: 28rpx;
  background: #fff;
  margin-top: 12rpx;
}
.empty .big { font-size: 80rpx; margin-bottom: 16rpx; }
.empty .e-p { margin: 12rpx 0; }
.empty .primary { margin-top: 28rpx; }

/* 穿线提醒横幅 */
.banner {
  background: linear-gradient(135deg, #fff8e1, #fff3c4);
  border: 1rpx solid #f0d97a;
  border-radius: 28rpx;
  padding: 26rpx 30rpx;
  margin-top: 28rpx;
  font-size: 28rpx;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}
.banner .b-icon { font-size: 40rpx; line-height: 1.2; }
.banner .b-body { flex: 1; }
.banner .b-title { font-weight: 800; color: #7a5e00; }
.banner .b-line { margin-top: 6rpx; color: #6b5413; }
.banner .mini { margin-top: 16rpx; }

.hint-line { color: #6b7269; font-size: 26rpx; margin: 16rpx 4rpx; }

/* 表单（球拍编辑页 / 打球记录编辑页共用） */
.form-wrap { padding-top: 32rpx; }
.hint { color: #6b7269; font-size: 26rpx; margin-bottom: 28rpx; }
.field { display: flex; flex-direction: column; margin-bottom: 28rpx; }
.label { font-size: 26rpx; font-weight: 700; color: #5d6560; margin-bottom: 12rpx; }
.label .opt { font-weight: 400; color: #9aa096; font-size: 24rpx; }
.row { display: flex; gap: 20rpx; }
.row .field { flex: 1; }
.input {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #e6e4dc;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}
.ph { color: #b3b8af; }
/* textarea 是多行组件，纵向 padding 正常生效，单独覆盖回 .input 的写法 */
.textarea {
  height: 200rpx;
  line-height: 1.5;
  padding: 20rpx 24rpx;
}
.picker-input { display: flex; align-items: center; }
.link-btn {
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 4rpx 8rpx;
  color: #2e7d32;
  font-size: 25rpx;
}
.sheet-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.sheet-actions .ghost,
.sheet-actions .primary { flex: 1; }
.ghost {
  background: #fff;
  color: #5d6560;
  border: 1rpx solid #e6e4dc;
  padding: 20rpx 36rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
