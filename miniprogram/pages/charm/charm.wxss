.empty-card {
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-emoji {
  font-size: 96rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #1f2421;
}

.mode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-item {
  width: calc((100% - 48rpx) / 4);
  padding: 18rpx 0;
  text-align: center;
  border-radius: 16rpx;
  background: #f0efe9;
  font-size: 26rpx;
  color: #43483f;
  box-sizing: border-box;
}

.mode-item.on {
  background: #2e7d32;
  color: #fff;
}

.swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.swatch {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 4rpx solid #e6e4dc;
  box-sizing: border-box;
}

.swatch.on {
  border-color: #1f2421;
  box-shadow: 0 0 0 4rpx rgba(46, 125, 50, 0.3);
}

.edit-mark {
  font-size: 26rpx;
}

.btn.danger {
  color: #c62828;
  border-color: #e5c1c1;
  background: #fff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 30rpx;
  color: #1f2421;
  font-weight: 500;
}

.row-sub {
  font-size: 24rpx;
  color: #8a8f8a;
  margin-top: 6rpx;
}
