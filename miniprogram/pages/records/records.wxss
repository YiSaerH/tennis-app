/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  align-items: center;
}
.f-picker { flex: 1; min-width: 0; }
.f-item {
  border: 1rpx solid #e6e4dc;
  border-radius: 20rpx;
  background: #fff;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1f2421;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}
.f-reset { flex-shrink: 0; padding: 18rpx 28rpx; }

/* 月历 */
.calendar {
  background: #fff;
  border: 1rpx solid #e6e4dc;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06), 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx;
  margin-top: 24rpx;
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.cal-title { flex: 1; text-align: center; font-weight: 700; font-size: 32rpx; white-space: nowrap; }
.cal-nav {
  border: 1rpx solid #e6e4dc;
  background: #fff;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1;
  color: #6b7269;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cal-wds { display: flex; }
.cal-wd {
  width: 14.2857%;
  text-align: center;
  font-size: 24rpx;
  color: #6b7269;
  padding: 8rpx 0;
  font-weight: 600;
}
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: 14.2857%; display: flex; justify-content: center; padding: 3rpx 0; }
.cal-day {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  color: #1f2421;
}
.cal-day.has { background: #2e7d32; color: #fff; font-weight: 700; }
.cal-day.today { box-shadow: inset 0 0 0 2px #2e7d32; }
.cal-day.has.today { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.85); }
.cal-day.sel { background: #1b5e20; }

/* 悬浮按钮：记一次打球 */
.fab {
  position: fixed;
  z-index: 100;
  right: 36rpx;
  bottom: 56rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #2e7d32;
  color: #fff;
  font-size: 64rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(46, 125, 50, 0.45);
}
